{
  "name": "@poker/shared",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --target es2022",
    "dev": "tsup src/index.ts --format esm --dts --sourcemap --target es2022 --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@poker/tsconfig": "workspace:*",
    "eslint": "^10.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
