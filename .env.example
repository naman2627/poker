# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every variable the app will need lives here.
# Nothing in this file is secret; .env itself is gitignored.
# ---------------------------------------------------------------------------

# Where accounts live.
#   postgres — the real thing. Needs DATABASE_URL and REDIS_URL below.
#   memory   — no database, no Redis, everything lost on restart. For local
#              development and the end-to-end run; refused in production.
AUTH_STORE=postgres

# Postgres connection string. Required when AUTH_STORE=postgres, and also where
# the record of play goes — hands, actions, and the fairness commitments. With
# AUTH_STORE=memory the record is kept in the process instead, and lost with it.
# Apply migrations with: pnpm --filter @poker/server db:migrate
DATABASE_URL=postgresql://poker:poker@localhost:5432/poker

# Redis. Required: holds pending one-time codes and the login rate limits.
REDIS_URL=redis://localhost:6379

# Auth signing secrets. Use two DIFFERENT long random values (32+ bytes).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# SMS one-time-code delivery for phone login.
#   console — prints the code to the server console. Local development only.
#   msg91   — SMS_API_KEY is the authkey, SMS_SENDER_ID is the flow template id.
#   twilio  — SMS_API_KEY is "accountSid:authToken", SMS_SENDER_ID is the from number.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=POKER

# Browser origin allowed to call the API and open a socket (CORS).
WEB_ORIGIN=http://localhost:3000

# Port the game server listens on.
PORT=4000

# The pauses a table takes on its own, in milliseconds.
#   SHOWDOWN_BEAT_MS — between the hands going face up and the chips moving
#   DEAL_DELAY_MS    — before a hand is dealt, so players who sat down together
#                      end up in the same one
SHOWDOWN_BEAT_MS=2000
DEAL_DELAY_MS=2500

# A fixed shuffle, so a test knows what the cards are. Leave this empty: with it
# set, every deck at every table is predictable. Refused in production.
TABLE_RNG_SEED=

# Where the browser reaches the game server. Public — never put a secret here.
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Run the web client on fixtures: no server, no database, no SMS. The whole
# interface is reviewable on its own, and /table/FELT42 replays a recorded hand.
#   unset — fixtures whenever NEXT_PUBLIC_SERVER_URL is empty
#   1     — always fixtures
#   0     — always the real server
# Per page load, ?fixture=1 and ?live=1 override whichever is set here.
NEXT_PUBLIC_FIXTURE=
